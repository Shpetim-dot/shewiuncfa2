+  ok(qa('#screenbody .sline').length >= 2, 'live screen lines: ' + qa('#screenbody .sline').length + ' kinds ' + qa('#screenbody .sline b').map((e) => e.textContent).join(','));
+  q('button[aria-label="Menu"]').click(); await wait(80);
+  ok(qa('.drawer .ditem').length >= 12 && !!q('input[aria-label="Search the menu"]') && qa('.quick .qbtn').length === 4 && qa('.drawer .badge').length >= 3, 'drawer: items ' + qa('.drawer .ditem').length + ' badges ' + qa('.drawer .badge').length + ' quick ' + qa('.quick .qbtn').length); q('button[aria-label="Close menu"]').click();
+  await menu('Teams'); await wait(800);
+  ok(qa('.cards .card').length >= 2, 'team cards: ' + qa('.cards .card').length);
+  await menu('Council'); await wait(800); const tp = q('textarea'); tp.value = 'Should we pilot agent payments?'; tp.dispatchEvent(new w.Event('input')); await wait(50); clickText('button', 'Start call'); await wait(700);
+  ok(qa('.ptile').length >= 3 && qa('.feed div').length >= 1, 'live room started: tiles ' + qa('.ptile').length);
+  const early = qa('.rchat .bub').length; await wait(4500);
+  ok(qa('.rchat .bub').length > early || qa('.rchat .bub').length >= 6, 'turns streamed in: ' + early + ' -> ' + qa('.rchat .bub').length);
+  ok(d.body.textContent.includes('Disagreement map') && qa('.plan li').length >= 3, 'decision + plan: ' + qa('.plan li').length);
+  await menu('Brain'); await wait(1500);
+  ok(qa('.tree .it').length >= 16, 'brain notes: ' + qa('.tree .it').length);
+  await wait(300);
+  ok(qa('.gwrap.dark svg circle').length >= 32 && qa('.gwrap.dark svg line').length >= 25, 'live graph circles (incl. halos): ' + qa('.gwrap.dark svg circle').length + ' lines: ' + qa('.gwrap.dark svg line').length);
+  const sel = q('select[aria-label="Whose brain"]'); sel.value = [...sel.options].find((o) => o.textContent.includes('Ledger')).value; sel.dispatchEvent(new w.Event('change')); await wait(1500);
+  ok(qa('.gwrap.dark svg circle').length >= 4 && d.getElementById('gcap').textContent.includes('Brain of Ledger'), 'agent brain: ' + d.getElementById('gcap').textContent.slice(0, 60));
+  await menu('Research'); await wait(900);
+  const rq = q('textarea'); rq.value = 'How should payment approvals and spend caps work for AI agents?'; rq.dispatchEvent(new w.Event('input')); clickText('button', 'Start research'); await wait(4500);
+  ok(qa('.bar-row').length >= 2 && d.body.textContent.includes('Summary'), 'research report + chart: bars ' + qa('.bar-row').length + ' sources ' + qa('.card .chip').length);
+  await menu('Inventory'); await wait(900);
+  ok(qa('tbody tr').length >= 8, 'inventory rows: ' + qa('tbody tr').length);
+  clickText('tbody tr button', 'Suspend'); await wait(800);
+  ok(qa('.chip.risk-suspended').length === 1, 'suspend works'); clickText('tbody tr button', 'Resume'); await wait(600);
+  await menu('Marketplace'); await wait(900);
+  ok(qa('.cards .card').length >= 6, 'marketplace cards: ' + qa('.cards .card').length);
+  clickText('.cards .card button', 'Add to workspace'); await wait(900);
+  ok(d.body.textContent.includes('added as'), 'import banner');
