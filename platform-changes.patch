+:root{--bg:#F6F0E3;--side:#EDE5D2;--surface:#FBF7EC;--ink:#12294F;--muted:#5B6B88;--line:#DDD3BC;--navy:#12294F;--on-navy:#F6F0E3;--accent:#2F5BD3;--bad:#A3321F;--r:12px;--on-accent:#fff;--graph:#0B1A33}
+@media (prefers-color-scheme:dark){:root{--bg:#0B1A33;--side:#0F2142;--surface:#14294F;--ink:#F3EAD7;--muted:#9FB0CF;--line:#243A63;--navy:#F3EAD7;--on-navy:#0B1A33;--accent:#7FA2FF;--bad:#FF9B8A;--on-accent:#0B1A33}}
+*{box-sizing:border-box}html,body{height:100%;margin:0}
+body{font:15px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink)}
+button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.muted{color:var(--muted)}.mono{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px}
+svg{flex:none}
+.tile{display:inline-grid;place-items:center;border-radius:28%;color:#fff;flex:none}
+.shell{display:grid;grid-template-columns:280px 1fr;height:100vh}.shell.has-panel{grid-template-columns:280px 1fr 320px}
+.side{background:var(--side);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
+.side-top{display:flex;align-items:center;gap:8px;padding:14px}.sp{flex:1}
+.ibtn{width:38px;height:38px;border-radius:10px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}
+.ibtn:hover{background:var(--bg)}
+.agents{flex:1;overflow:auto;padding:0 8px 8px}
+.group{font-size:12px;color:var(--muted);padding:12px 10px 4px}
+.agent{display:flex;gap:12px;align-items:center;width:100%;text-align:left;border:0;background:none;padding:8px 10px;border-radius:var(--r)}
+.agent:hover{background:var(--bg)}.agent[aria-current=true]{background:var(--surface);box-shadow:inset 3px 0 0 var(--accent),0 0 0 1px var(--line)}
+.agent b{display:block;font-weight:600;line-height:1.2}.agent small{display:block;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:180px}
+.acct{display:flex;gap:10px;align-items:center;margin:8px;padding:8px 10px;border-radius:var(--r);border:1px solid var(--line);background:var(--surface);width:calc(100% - 16px);text-align:left;position:relative}
+.acct small{display:block;color:var(--muted);font-size:12px;line-height:1.2}
+.pop{position:absolute;bottom:56px;left:8px;right:8px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:6px;z-index:8;box-shadow:0 4px 16px rgba(0,0,0,.12)}
+.pop button,.menuitem{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;background:none;padding:8px 10px;border-radius:8px}
+.pop button:hover{background:var(--side)}
+.main{display:flex;flex-direction:column;min-height:0;min-width:0}
+.bar{display:flex;align-items:center;gap:12px;padding:12px 24px;border-bottom:1px solid var(--line)}
+.bar h1{font-size:16px;margin:0;font-weight:600}
+.chip{display:inline-block;font-size:12px;padding:1px 8px;border-radius:999px;border:1px solid var(--line);color:var(--muted);background:var(--surface)}
+.chip.ok{color:var(--ink)}.chip.warn{color:var(--bad);border-color:var(--bad)}
+.banner{padding:8px 24px;font-size:13px;border-bottom:1px solid var(--line);background:var(--surface);display:flex;gap:12px;align-items:center}
+.body{flex:1;overflow:auto;padding:24px}.col{max-width:760px;margin:0 auto}.wide{max-width:1040px;margin:0 auto}
+.msgs{display:flex;flex-direction:column;gap:12px}
