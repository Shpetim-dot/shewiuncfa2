+        owner TEXT, source TEXT, created_at TEXT, updated_at TEXT);
+    CREATE TABLE IF NOT EXISTS calls(id TEXT PRIMARY KEY, topic TEXT, mode TEXT, events TEXT, decision TEXT, created_at TEXT);
