+                    "criticality": b.get("criticality") or "medium", "owner": b.get("owner") or "system", "created_at": b.get("created_at"), "scopes": len(b["scopes"]),
+                    "tool_grants": len(mine), "write_grants": writes, "risk": risk_of(b, writes)})
