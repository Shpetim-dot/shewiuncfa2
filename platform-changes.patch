+  ok((q('.side-top .logo') || {}).textContent === 'Shewiun', 'bold text logo only: ' + (q('.side-top .logo') || {}).textContent);
+  ok(!!q('.appsbtn') && q('.appsbtn').textContent.includes('Connect apps'), 'Connect apps button bottom-left: ' + (q('.appsbtn') || {}).textContent);
