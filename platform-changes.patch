+const wait = (ms) => new Promise((r) => setTimeout(r, ms));
+(async () => {
+  const dom = await JSDOM.fromURL('http://localhost:8768/', { runScripts: 'dangerously', resources: 'usable', pretendToBeVisual: true, virtualConsole: vc,
+    beforeParse(win) { win.fetch = (u, o) => fetch(new URL(u, 'http://localhost:8768').href, { ...o, signal: undefined }); win.TextDecoder = TextDecoder; win.URL.createObjectURL = () => 'blob:x'; } });
