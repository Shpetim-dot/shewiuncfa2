+  const q = (s) => d.querySelector(s), qa = (s) => [...d.querySelectorAll(s)];
+  const clickText = (sel, t) => { const el = qa(sel).find((e) => e.textContent.includes(t)); if (!el) throw new Error('missing ' + sel + ' ' + t); el.click(); };
